# Threat2Risk AI Production Environment Variables for Vercel
# In your Vercel Project Dashboard -> Settings -> Environment Variables, add:
#
# Key: VITE_API_URL
# Value: https://<your-backend-app>.up.railway.app
#
# (Optional) If you have a custom WebSocket gateway:
# Key: VITE_WS_URL
# Value: wss://<your-backend-app>.up.railway.app/ws/events

VITE_API_URL=https://your-backend-service.up.railway.app
